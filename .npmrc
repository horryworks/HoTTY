; Supply-chain hardening.
; (Config files live at repo root, NOT under .claude/ which is gitignored.)

; Pin the public registry — defends against registry / dependency-confusion swaps.
registry=https://registry.npmjs.org/

; New `npm install <pkg>` writes an exact version (stops new caret creep).
save-exact=true

; Keep package-lock.json authoritative; always install with `npm ci` (never `npm install`).
package-lock=true

; Audit defaults aligned with .claude/rules/security.md (resolve Medium/High/Critical).
audit=true
audit-level=moderate

; Enforce the package.json "engines" range (Node 24.x / npm >=11.10, the first npm
; that understands `min-release-age` below).
engine-strict=true

; Supply-chain cooldown: `npm install` / `npm update` only resolve versions that were
; published at least 7 days ago — direct AND transitive. Malicious versions are
; normally caught and unpublished well inside that window. `npm ci` installs the
; lockfile as-is and is not affected.
; A known vulnerability that affects HoTTY is the one exception: install the fix
; without waiting, e.g. `npm install <pkg>@<fixed> --min-release-age=0`, after
; checking its diff and `npm audit signatures`. See CLAUDE.md, Dependency Supply-Chain Policy.
min-release-age=7

; NOTE: `ignore-scripts=true` is intentionally NOT set.
; On this toolchain it breaks the build: npm drops lightningcss's optional platform
; package (lightningcss-win32-x64-msvc), so `vite build` cannot load the native
; binary. The install-script / malicious-postinstall vector is instead covered by
;   (1) package-lock.json + SRI integrity hashes — a pinned version cannot be
;       tampered with silently, and
;   (2) the `min-release-age` cooldown above — a malicious NEW version is not
;       adopted for 7+ days, the window in which such versions are normally yanked.
